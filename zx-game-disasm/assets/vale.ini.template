# Vale reads prose.md, which extract_prose.py lifts out of the .skool and .ref
# files; vale_report.py maps Vale's positions back to their lines.

StylesPath = styles
# vale_report.py --fail-on error sets the exit status; suggestions are reported
# and never fail the build.
MinAlertLevel = suggestion

Packages = Microsoft, Google

[*.md]
BasedOnStyles = Vale, Microsoft, ZXDisasm

# Consumer-documentation voice rules. Contractions also autofixes "does not" to
# "doesn't" across the listing.
Microsoft.Contractions = NO
Microsoft.We = NO
Microsoft.FirstPerson = NO
Microsoft.UIVerbs = NO

# Rules that fire on the domain:
#   Vale.Repetition    repeated mnemonics, as in "two NOPs"
#   Microsoft.Spacing  a field reference such as slot_1.X
#   Microsoft.Units    "three pixels" in prose
#   Microsoft.Negative -1 as a register value
#   Microsoft.Acronyms on-screen captions such as SCORE and PRESS
#   Microsoft.Uppercase the same captions
#   Microsoft.Jargon   "glyph", which the glossary defines
#   Microsoft.QuestionMarks a question on a test, answered on the branch
#   Microsoft.Vocab    a prompt to consult a word list
#   Microsoft.Ellipses every ellipsis; make lint-comments checks splices
Vale.Repetition = NO
Microsoft.Spacing = NO
Microsoft.Units = NO
Microsoft.Negative = NO
Microsoft.Acronyms = NO
Microsoft.Uppercase = NO
Microsoft.Jargon = NO
Microsoft.QuestionMarks = NO
Microsoft.Vocab = NO
Microsoft.Ellipses = NO

Microsoft.Hyphens = suggestion
Microsoft.Quotes = suggestion

# styles/config/vocabularies/ has no vocabulary for Z80 or the game.
Vale.Spelling = NO

# extract_prose.py writes no headings, so these rules have nothing to read.
Microsoft.Headings = NO
Google.Headings = NO
