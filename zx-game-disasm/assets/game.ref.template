; Main SkoolKit HTML config for {Game Title}. Build the site with:
;
;   skool2html.py -d html -o game.skool game.ref
;
; List extra ref files in RefFiles; create each as you add pages.

[Config]
RefFiles=graphics.ref;sound.ref;data.ref;notes.ref;glossary.ref
GameDir=game

; This file is parsed FIRST — before every other project ref and before the
; skill's theme.ref — so it is the project's own place for the site's defaults.
; The theme states nothing that belongs here; change any of the lines below and
; the change takes effect.
[Game]
Game={Game Title}

; The theme is opt-in per sheet, and this is where it is opted into. Reorder or
; drop a name and the site loses that layer: skoolkit.css is SkoolKit's own
; structural sheet, theme.css is the skill's dark layout, {game}.css is this
; project's identity and loads last so its rules win.
StyleSheet=skoolkit.css;theme.css;{game}.css

; Hex page filenames and hex in-page anchors, to match a hex-addressed .ctl —
; one base everywhere, per references/ctl-authoring.md. Drop both lines for
; SkoolKit's decimal stock, but drop them together: a hex filename with a
; decimal anchor is two bases on one URL.
AddressAnchor={address#IF({base}==16)(:04x)}

; Link the operands a reader will chase: SkoolKit links only CALL, DEFW, DJNZ,
; JP and JR, so a pointer loaded with LD would link nowhere. See "Link every
; operand the reader will chase" in references/html-docs.md.
LinkOperands=CALL,DEFW,DJNZ,JP,JR,LD

; Release= renders under the game title on the index, and Copyright= renders in
; the footer. Both are hidden while empty, so an unset one reserves no blank
; band.
Release=
Copyright=

; [Index] lists the groups the home page draws, in this order: SkoolKit's own
; list, then Spec, the behavior pages that site/spec_pages.py writes from
; spec/*.md. A group missing here is not drawn, and neither is a group with no
; pages, so the list can name Spec before spec/ exists.
[Index]
MemoryMaps
Graphics
DataTables
OtherCode
Reference
Spec

; Index headings group pages on the home page. Each name must match a [Page:...]
; or a generated page id.
[Index:Graphics:Graphics and sound]
Graphics
Sound

[Index:DataTables:Data tables and buffers]
Data

[Index:Reference:Reference]
Notes
Glossary

[Paths]
; The other half of the hex base declared in [Game] above.
CodeFiles={address:04X}.html
Graphics=graphics/graphics.html
Sound=sound/sound.html
Data=data/data.html
Notes=reference/notes.html
Glossary=reference/glossary.html

[Links]
Graphics=Game graphics
Sound=Sound effects
Data=Data tables
Notes=Implementation notes
Glossary=Glossary
GameStatusBuffer=Variables

[Titles]
Graphics=Game graphics
Sound=Sound effects
Notes=Implementation notes
Asm-g=Variables at {entry[address]}
GameStatusBuffer=Variables

; The `g` entries are the variables and buffers the game writes as it runs.
; SkoolKit heads them "Game status buffer", a storage word for what the reader
; browses as the game's variables (HEAD-2). Name them in this game's terms.
[PageHeaders]
Asm-g=Variables
GameStatusBuffer=Variables
