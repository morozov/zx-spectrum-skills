; The structural laws over a '{ }' comment group's span, with the near misses
; that must stay silent.
;
; Expected, and nothing else:
;   GROUP_SPLIT at $EC05 — the group spans a JR whose target is outside it.
;   GROUP_ENTRY at $EC22 — an interior row is jumped to from $EC2C, outside.
;   GROUP_SKIP  at $EC40 — the group's own branch jumps forward over that row.
;   BASE_ECHO   at $EC35 — one comment spells one value in both bases.
;   OPERAND_ECHO at $EC35 — and quotes a byte its own span carries.
;   SPLICE      at $EC4E — a comment finishing the sentence above it.
;   LAYOUT_ECHO at $EC47 — a code comment citing a record's field offset.
;   PITCH       at $EC56 — a comment stating the pitch the clip plays.
;   ELLIPSIS    at $EC5C and $EC5E — one thought chained across two groups
;               by '...' instead of written over the rows it covers.
;   SYNTH_ECHO  at $EC66 — prose beside an #AUDIO saying how the tone is made.
;   EULOGY     at $EC6E — a proof that a block of unused bytes is unused.
;   UNRENDERED at $EC76 — a block titled a sprite that shows no sprite.
;   CODE_ECHO  at $EC82, $EC84 and $EC8A — numbers the player cannot see:
;               a dispatch code, a state index, a tile range.
;
; Silent by construction: the branch target at $EC11 is its span's own loop top,
; reached only from below it; the conditional RET at $EC21 abandons the act
; rather than starting another; and the elided sequence at $EC62 is an ellipsis
; standing for omitted values, not a comment spliced across rows; and the entry
; at $EC6A renders its sound and says only what the sound is and what fires it,
; which is what an entry beside a clip owes; and the unused block at $EC72 says
; that it is unused and one thing worth knowing, which is all one owes; the
; sprite at $EC7A renders itself, and the pointer table at $EC7E names sprites
; without holding one, so neither owes a picture; and the dispatch table at
; $EC86 is where a type number is the content, so it is not reported. Nor are
; the register contract at $EC8E, the platform bit at $EC90, or the Z80
; mnemonic at $EC92 — a contract states a convention, and a port bit and an
; instruction are not this program's to reassign.
; The equation at $EC96 opens lower case under a row with no full stop, and is
; silent: a noun-phrase row takes no full stop, and an identifier and its
; operator start a statement of their own, not the rest of the row above.

@label=split_span
c$EC00 LD A,$01       ; {Arm the shot, then blank the stale sprite cell.
 $EC02 LD ($FC00),A   ;
 $EC05 JR $EC0B       ;
 $EC07 XOR A          ;
 $EC08 LD ($FC01),A   ; }
; This entry point is used by the routine at #R$EC00.
@label=split_span_tail
*$EC0B RET            ;

@label=internal_loop
c$EC0C LD B,$08       ; {Blank the slot bytes.
 $EC0E LD HL,$FC00    ;
*$EC11 LD (HL),$00    ;
 $EC13 INC HL         ;
 $EC14 DJNZ $EC11     ; }
 $EC16 RET            ;

@label=early_out
c$EC1D LD A,($FC00)   ; {Fire only while the slot is armed.
 $EC20 OR A           ;
 $EC21 RET Z          ;
; This entry point is used by the routine at #R$EC28.
@label=fire_shot
*$EC22 LD A,$02       ;
 $EC24 LD ($FC02),A   ; }
 $EC27 RET            ;

@label=other_caller
c$EC28 LD A,($FC01)   ; {Fire from the other path.
 $EC2B OR A           ;
 $EC2C JP $EC22       ; }

; A clamp whose skip-branch lands inside its own span, with the comment running
; on past the branch target — the shape a missing length leaves when a comment
; stretches to the next documented address instead of stopping at the act. The
; rows from $EC40 do not run on the skipping path. Its parenthetical is the
; second defect: one value, both bases.
@label=clamp_and_prime
c$EC35 LD A,($FC00)   ; {Clamp the stored width to a maximum of $8A (138), then
 $EC38 CP $8A         ; aim the sprite pointer.
 $EC3A JR C,$EC40     ;
 $EC3C LD A,$8A       ;
 $EC3E LD ($FC00),A   ;
@label=prime_ptr
*$EC40 LD HL,$FD00    ;
 $EC43 LD ($FC02),HL  ; }
 $EC46 RET            ;

; A record's layout quoted into prose about behavior, and a sentence cut in
; half across two comment units. The offset belongs at the record's own block;
; the second comment describes nothing on its own.
@label=track_slot
c$EC47 LD HL,($FC10)  ; Read the slot's +0/+1 position word.
 $EC4A LD A,H         ; {Hold the slot while the fade settles,
 $EC4B OR L           ;
 $EC4C JR Z,$EC55     ; }
*$EC4E LD A,(HL)      ; {and release it once the fade has passed.
 $EC4F INC HL         ; }
*$EC55 RET            ;

; The pitch of an effect, written beside the routine that plays it. The clip
; conveys it; the comment owes the trigger instead. The frame interrupt below is
; the machine's tick, not a pitch, and stays silent.
@label=play_blip
c$EC56 LD D,$64       ; The door-close click, ~1.3 kHz.
 $EC58 CALL $FD00     ; {Hold it for one tick of the 50 Hz frame interrupt.
 $EC5B RET            ;

; A thought chained across two comment groups by '...'. The rows it covers are a
; single act, so they owe one group over both, not two groups holding half a
; sentence each. The splice is authored, which is what makes it decidable — and
; it hides inside braces, so the check must look inside them too.
@label=copy_glyph_row
c$EC5C LD A,(DE)      ; {Copy one font row to the screen...
 $EC5D INC H          ; }
*$EC5E LD (HL),A      ; {...stepping down one pixel row each time.
 $EC5F DJNZ $EC5C     ; }
 $EC61 RET            ;

; An ellipsis standing for values left out of a sequence. It elides, it does not
; splice, and the row it sits on is the whole thought.
@label=score_run
c$EC62 LD A,(HL)      ; A run scores 10, 20, 30 ... up to 250.
 $EC64 RET            ;

; The ALARM siren, 7 frames of 12 cycles each, with the period computed as
; 2*counter + 10 and held flat within each frame.
; #AUDIO(alarm-siren)
@label=sfx_alarm
c$EC66 LD D,$14       ; Step the pitch down once per poll.
 $EC68 RET            ;

; The same shape, written the way it should be. It renders the clip and says what
; the sound is and what fires it, so nothing here is the clip read back.
; #AUDIO(door-opened)
@label=sfx_door
c$EC6A LD D,$28       ; The blip a door makes as it slides open.
 $EC6C RET            ;

; Undetermined tail of the state block; no reader found in the image, and the
; only writer is the level-setup clear, whose fill stops seven bytes in, so
; nothing fixes a stride here and the size is the whole claim.
@label=unused_tail
u$EC6E DEFS $04

; Unused. The loader's leftovers from the old BASIC area, kept because the image
; runs contiguously into the table below.
@label=loader_residue
u$EC72 DEFS $04

; Player sprite: normal player bitmap
@label=player_sprite
b$EC76 DEFB $30,$30   ; Two bytes per pixel row.

; Shot sprite bitmap
; #UDGARRAY2,7,3,2($EC7A;$EC7C)(shot_sprite)
@label=shot_sprite
b$EC7A DEFB $18,$18   ; Two bytes per pixel row.

; Sprite pointer table, one entry per sprite slot
@label=sprite_pointers
b$EC7E DEFW $EC76     ; The normal player.

; Drone behavior handler (object type 12)
;
; Type-12 enemy: the drone. Roams the play area until a shot destroys it.
@label=enemy_drone
c$EC82 LD A,(HL)      ; Read its state.

; Object dispatch table, one handler per type
;
; Indexed by object type. A row that opens on its type repeats its position,
; so DATA_ECHO reports it.
@label=dispatch_table
b$EC86 DEFW $EC82     ; Type 12, the drone.

; Enemy state machine
;
; On a hit the object enters state 2 and stops moving. A solid tile is a
; wall/border (tile codes $21-$44).
@label=enemy_state
c$EC84 LD A,(HL)      ; Read it.

; Score award
;
; The drone is worth 300 points and the shield lasts 640 frames, both of which
; the player meets, so both stay.
@label=score_award
c$EC8A LD A,$05       ; Award it.

; Print a string
;
; I:DE address of the message (bit 7 set on its last character)
@label=print_string
c$EC8E LD A,(DE)      ; Read a character.

; Speaker toggle
;
; Flips ULA bit 4 and returns. The BIT 7 test above it reads the mute flag.
@label=speaker
c$EC90 XOR $10        ; Toggle it.

; Door attribute table
;
; Indexed by door code. The first row quotes its own byte and is reported;
; the second says what it holds and is not.
@label=door_attr
b$EC92 DEFB $45      ; The steel door, bright cyan ($45).
 $EC93 DEFB $41      ; The KEY pickup door.

; Drift code
;
; A variable documents its encoding on its own row, and the byte is only the
; value the snapshot caught, so naming $00 here is not an echo.
@label=drift_code
g$EC94 DEFB $00      ; $FF none, $00 hit moving right, $02 hit moving left.

; Contact gap
;
; A noun-phrase row with no full stop, then an equation on its own identifier.
@label=contact_gap
c$EC95 LD A,D         ; No contact
 $EC96 SUB E          ; dy = top.Y - base.Y
